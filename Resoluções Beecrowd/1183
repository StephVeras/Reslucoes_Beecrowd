#include<stdio.h>

int main(){
    int n =0;
    float soma = 0;
    char l;
    float matriz[12][12];

    scanf("%c", &l);

    for(int i=0; i<12;i++){
        for(int j=0;j<12;j++){
            scanf("%f", &matriz[i][j]);
        }
    }

    for(int i=0; i<12;i++){
        for(int j=0;j<12;j++){
            if(i < j){
                soma+= matriz[i][j];
                n++;
            }
        }
    }
    

    if(l == 'S'){
        printf("%.1f\n", soma);
    } else if(l == 'M'){
        soma /= n;
        printf("%.1f\n", soma);
    }

    return 0;
}
